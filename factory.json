{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "project_name": "AGY-Herdr Software Factory",
  "version": "5.0.0",
  "default_model": "gemini-3.8-flash-high",
  "worker_registry": {
    "agy": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy",
      "profile_home": "/root/.gemini/antigravity-cli",
      "enabled": true,
      "capabilities": [
        "implementation",
        "review",
        "planning",
        "testing"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": true,
      "description": "Primary AGY instance (reserved when orchestrator is agy)"
    },
    "agy2": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy2",
      "profile_home": "/root/.agy2_home",
      "enabled": true,
      "capabilities": [
        "planning",
        "specification",
        "review"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Product Specification and Planning Worker"
    },
    "agy3": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy3",
      "profile_home": "/root/.agy3_home",
      "enabled": true,
      "capabilities": [
        "coding",
        "backend",
        "debugging"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Backend & Storage Implementation Worker"
    },
    "agy4": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy4",
      "profile_home": "/root/.agy4_home",
      "enabled": true,
      "capabilities": [
        "coding",
        "frontend"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Frontend UI & Client Implementation Worker"
    },
    "agy5": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy5",
      "profile_home": "/root/.agy5_home",
      "enabled": true,
      "capabilities": [
        "coding",
        "testing"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Test Suite & Smoke Harness Worker"
    },
    "agy6": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy6",
      "profile_home": "/root/.agy6_home",
      "enabled": true,
      "capabilities": [
        "integration",
        "debugging",
        "conflict_resolution"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Integration Quality & Repair Worker"
    },
    "agy7": {
      "family": "antigravity",
      "command": "/root/.local/bin/agy7",
      "profile_home": "/root/.agy7_home",
      "enabled": true,
      "capabilities": [
        "review",
        "audit"
      ],
      "adapter": "agy",
      "invocation_adapter": "antigravity_cli",
      "default_model": "gemini-3.8-flash-high",
      "concurrency_eligibility": false,
      "description": "Independent Final Audit Worker"
    },
    "droid": {
      "family": "droid",
      "command": "/root/.local/bin/droid",
      "profile_home": "/root/.factory",
      "enabled": true,
      "capabilities": [
        "coding",
        "backend",
        "testing",
        "debugging",
        "mechanical_change"
      ],
      "adapter": "droid",
      "invocation_adapter": "droid_cli",
      "default_model": "qwen3.8-max",
      "reasoning_effort": "xhigh",
      "autonomy": "low",
      "concurrency_eligibility": false,
      "description": "Production Droid Worker (Qwen3.8 Max, Low Autonomy)"
    },
    "codex": {
      "family": "openai",
      "command": "/usr/local/bin/codex",
      "profile_home": "/root/.codex",
      "enabled": true,
      "capabilities": [
        "coding",
        "frontend",
        "debugging",
        "testing",
        "review"
      ],
      "adapter": "codex",
      "invocation_adapter": "codex_cli",
      "default_model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "concurrency_eligibility": false,
      "description": "Production OpenAI Codex CLI Worker (GPT-5.6 Luna High)"
    }
  },
  "harness_profiles_path": "harness_profiles.json",
  "future_worker_adapters": {
    "claude": {
      "family": "anthropic",
      "adapter_type": "command_adapter",
      "binary": "claude",
      "capabilities": [
        "planning",
        "implementation",
        "review"
      ],
      "invocation_protocol": "herdr-pane-cli",
      "status": "planned",
      "notes": "Ready for v6 integration upon installation of claude CLI wrapper"
    },
    "opencode": {
      "family": "opencode",
      "adapter_type": "command_adapter",
      "binary": "opencode",
      "capabilities": [
        "coding",
        "testing"
      ],
      "invocation_protocol": "herdr-pane-cli",
      "status": "planned",
      "notes": "Ready for v6 integration upon installation of opencode CLI wrapper"
    },
    "freebuff": {
      "family": "freebuff",
      "adapter_type": "command_adapter",
      "binary": "freebuff",
      "capabilities": [
        "planning",
        "implementation"
      ],
      "invocation_protocol": "herdr-pane-cli",
      "status": "planned",
      "notes": "Ready for integration upon installation of freebuff CLI wrapper"
    }
  },
  "guardrails": {
    "enforce_path_allowlist": true,
    "require_clean_git_base": true,
    "disallow_sudo": true,
    "disallow_global_installs": true,
    "disallow_orchestrator_cleanup": true
  }
}