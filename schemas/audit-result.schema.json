{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FinalAuditResult",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REMEDIATION_REQUIRED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "MAJOR",
              "MINOR",
              "INFO"
            ]
          },
          "area": {
            "type": "string",
            "enum": [
              "implementation",
              "tests",
              "security",
              "traceability"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "area",
          "evidence",
          "recommendation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
