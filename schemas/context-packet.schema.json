{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextPacket",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["8.0.0"]
    },
    "packet_id": {
      "type": "string",
      "description": "Unique identifier for this compiled context packet"
    },
    "packet_role": {
      "type": "string",
      "enum": ["planner", "reviewer", "task", "auditor", "remediation"],
      "description": "Target agent role for this context packet"
    },
    "goal_id": {
      "type": "string",
      "description": "Identifier of the associated high-level goal"
    },
    "run_id": {
      "type": ["string", "null"],
      "description": "Identifier of the orchestration run if applicable"
    },
    "task_id": {
      "type": ["string", "null"],
      "description": "Identifier of the specific task if applicable"
    },
    "attempt_id": {
      "type": ["integer", "null"],
      "description": "Attempt sequence number if applicable"
    },
    "source_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of source file or artifact paths used to compile this packet"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "SHA-256 hashes of all source artifacts to detect staleness"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "provenance": { "type": "string", "enum": ["USER_EXPLICIT", "DERIVED"] }
        },
        "required": ["id", "description"]
      },
      "description": "Scoped acceptance criteria relevant to this role"
    },
    "required_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "anchor_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "requirement",
              "invariant",
              "interface_contract",
              "file_reference",
              "dependency_decision",
              "validation",
              "allowed_path",
              "protected_path"
            ]
          },
          "source": { "type": "string" },
          "source_hash": { "type": "string" },
          "content": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "required": ["anchor_id", "type", "source", "source_hash", "required"]
      },
      "description": "Anchors that must survive context compilation and pruning"
    },
    "included_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" },
          "byte_count": { "type": "integer" },
          "source_hash": { "type": "string" },
          "inline_content": { "type": "string" }
        },
        "required": ["path", "reason", "byte_count", "source_hash", "inline_content"]
      },
      "description": "Files whose excerpts are explicitly inlined with cryptographic provenance"
    },
    "referenced_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File paths available in the worktree for the agent to inspect directly"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Task dependencies"
    },
    "handoffs": {
      "type": "array",
      "items": { "type": "object" },
      "description": "HandoffPackets from predecessor tasks"
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Deterministic validation commands associated with this packet"
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Operational and project constraints"
    },
    "budget": {
      "type": "object",
      "properties": {
        "soft_budget_bytes": { "type": "integer" },
        "hard_budget_bytes": { "type": "integer" },
        "original_bytes": { "type": "integer" },
        "pruned_bytes": { "type": "integer" },
        "final_bytes": { "type": "integer" },
        "was_pruned": { "type": "boolean" }
      },
      "required": ["soft_budget_bytes", "hard_budget_bytes", "original_bytes", "final_bytes", "was_pruned"]
    },
    "packet_bytes": {
      "type": "integer",
      "description": "Total rendered size in bytes of the dynamic context packet"
    },
    "packet_hash": {
      "type": "string",
      "description": "SHA-256 hash of the rendered context packet content"
    },
    "token_count": {
      "type": ["integer", "null"],
      "description": "Provider-reported or exact tokenizer token count, null when not available"
    },
    "rendered_tail": {
      "type": "string",
      "description": "The rendered dynamic tail prompt content"
    },
    "compiler_version": {
      "type": "string",
      "description": "Version of ContextCompiler that produced this packet"
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 creation timestamp"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "packet_role",
    "goal_id",
    "source_artifacts",
    "source_hashes",
    "requirements",
    "required_anchors",
    "referenced_files",
    "validations",
    "packet_bytes",
    "packet_hash",
    "compiler_version"
  ]
}
