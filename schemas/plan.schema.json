{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrchestrationPlan",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique identifier for this orchestration plan"
    },
    "version": {
      "type": "string",
      "description": "Plan schema version"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name of the plan"
    },
    "goal_id": {
      "type": "string",
      "description": "Optional ID of the goal that produced this plan"
    },
    "requirements_traceability": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Mapping from requirement/criterion ID to task IDs satisfying it"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wave_index": { "type": "integer" },
          "description": { "type": "string" },
          "tasks": {
            "type": "array",
            "items": { "$ref": "#/definitions/task" }
          }
        },
        "required": ["wave_index", "tasks"]
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/definitions/task" }
    }
  },
  "required": ["plan_id", "version", "name"],
  "definitions": {
    "task": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "name": { "type": "string" },
        "task_type": { "type": "string" },
        "worker_id": { "type": "string" },
        "worker": { "type": "string" },
        "profile": { "type": "string" },
        "description": { "type": "string" },
        "prompt": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "satisfies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Requirement/criterion IDs satisfied by this task"
        },
        "validations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "string" },
                "description": "Safe argv array, e.g. [\"python3\", \"-m\", \"unittest\", \"tests/test_x.py\"]"
              },
              {
                "type": "string",
                "description": "Validation command string"
              }
            ]
          },
          "description": "Deterministic post-task or post-goal validation commands"
        }
      },
      "required": ["task_id"]
    }
  }
}
